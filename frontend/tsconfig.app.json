{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* `node` **n'est pas** ici : l'ajouter au projet rendait `process`, `Buffer` et `node:fs`
       résolvables depuis n'importe quel composant — donc du code Node type-checké au vert avant
       d'exploser au chargement, sur une tablette, dans le gymnase. Le seul fichier qui en a besoin
       (`shared/charte.test.ts`, qui lit les feuilles de style sur disque) le référence lui-même par
       `/// <reference types="node" />`. Trou refermé à la revue d'E17US001. */
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Typage strict (E00US002 — guide-architecture.md §5) */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
